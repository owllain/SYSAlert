# Vercel Postgres URL (Obtenla en el panel de Storage de Vercel)
DATABASE_URL="postgres://default:password@ep-host.region.aws.neon.tech:5432/verceldb?sslmode=require"

# Si quieres seguir usando SQLite localmente, deberás cambiar el 'provider' en schema.prisma a 'sqlite' 
# y volver a usar: DATABASE_URL="file:./db/custom.db"
